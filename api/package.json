{
  "name": "crackers-hyderabad-api",
  "private": true,
  "version": "1.0.0",
  "description": "Portable Express API for Crackers Hyderabad",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "health": "node -e \"fetch(`http://127.0.0.1:${process.env.PORT||3001}/api/health`).then(r=>r.text().then(t=>{console.log(r.status,t);process.exit(r.ok?0:1)})).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3"
  }
}
