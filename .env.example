# Crackers Hyderabad — environment template.
# Copy to `.env` (server, local KVM/production) — never commit real values.
# Browser variables live in `client/.env*` (VITE_*); see client/.env.example.

# =============================================
# Server (api/server.js)
# =============================================
# Port the Express API listens on. Hostinger KVM runs it under PM2 on 3001
# behind an Nginx /api reverse proxy. Always honour PORT when set.
PORT=3001

# Extra browser origins allowed to call the API (comma-separated).
# Defaults already cover localhost, crackershyderabad.com and www.
# Add preview URLs here, e.g. ALLOWED_ORIGINS=https://my-preview.vercel.app
ALLOWED_ORIGINS=

# Firebase Admin SDK (REQUIRED for api auth, orders, users).
# Paste the whole service-account JSON on one line, or place the file at
# ./service-account.json for local development only (it is git-ignored).
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional override; defaults to the project_id inside the service account.
FIREBASE_PROJECT_ID=standard-crackers-store

# Media storage (Hostinger KVM). Defaults serve production already:
# MEDIA_ROOT=/var/www/crackershyderabad-media
# MEDIA_PUBLIC_BASE=https://crackershyderabad.com/uploads
MEDIA_ROOT=
MEDIA_PUBLIC_BASE=

# =============================================
# Email (order invoices sent to customers)
# =============================================
# For Gmail: enable 2-Step Verification, then create an App Password and
# use that 16-character password below (spaces optional).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail.address@gmail.com
EMAIL_PASS=

# =============================================
# MSG91 SMS (order confirmation + status updates)
# =============================================
# Get your auth key from https://control.msg91.com (API & Developers > API Key).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CRAKER
MSG91_ROUTE=4

# =============================================
# Deploy (Hostinger KVM auto-deploy, GitHub Secrets)
# =============================================
# DEPLOY_TOKEN — random token shared with /root/crackers-deploy/.deploy-token
# DEPLOY_HOST  — hostname serving /api/deploy, e.g. crackershyderabad.com
DEPLOY_TOKEN=
DEPLOY_HOST=

# =============================================
# Browser build (Vite — set as GitHub/Vercel env vars in CI)
# =============================================
# These are PUBLIC and ship inside the browser bundle by design.
# CI falls back to client/.env.production when secrets are absent.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Same-origin API proxy on both hosts. Leave as /api.
VITE_BACKEND_API_URL=/api
